{
	"name": "dkrh",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"db:init": "cd apps/hono && bun run src/test/initdb.ts",
		"add:db": "cd packages/db && bun add",
